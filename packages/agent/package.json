{
  "name": "@outis-wallet/agent",
  "version": "0.1.0",
  "description": "Outis agent accounts: the session a user approves for a bot, the link that asks for it, and the transactions it signs within its limits",
  "keywords": [
    "outis",
    "starknet",
    "agent",
    "session",
    "wallet"
  ],
  "homepage": "https://github.com/outis-wallet/agent/tree/main/packages/agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outis-wallet/agent.git",
    "directory": "packages/agent"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@outis-wallet/typed-data": "workspace:^",
    "starknet": "10.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
